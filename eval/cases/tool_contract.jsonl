{"id": "TC-01-economics-summary", "case": "economics_summary", "description": "Сводка по проекту: ставка человека и пустой ROI без затрат", "tool": "economics_summary", "args": {"project_slug": "demo"}, "expect": {"status": "ok", "json_contains": {"project": "demo", "currency": "USD"}, "json_path_equals": {"roi": null, "unpriced_models": []}}}
{"id": "TC-02-unknown-project", "case": "unknown_project", "description": "Неизвестный проект → понятная ошибка, не 500", "tool": "economics_summary", "args": {"project_slug": "absent"}, "expect": {"status": "error", "error_contains": "not found"}}
{"id": "TC-03-set-project-economics", "case": "set_project_economics", "description": "Ставка человека записывается и применяется", "tool": "set_project_economics", "args": {"project_slug": "demo", "human_rate_usd_per_hour": 75.0}, "expect": {"status": "ok", "json_contains": {"project": "demo", "human_rate_usd_per_hour": 75.0}}}
{"id": "TC-04-set-project-economics-invalid", "case": "set_project_economics_invalid", "description": "Отрицательная ставка отвергается на границе", "tool": "set_project_economics", "args": {"project_slug": "demo", "human_rate_usd_per_hour": -1.0}, "expect": {"status": "error", "error_contains": "greater than zero"}}
{"id": "TC-05-set-model-price", "case": "set_model_price", "description": "Цена модели записывается и появляется в списке цен", "tool": "set_model_price", "args": {"pattern": "demo-*", "input_usd_per_mtok": 2.0}, "expect": {"status": "ok", "json_contains": {"pattern": "demo-*", "created": true}}}
{"id": "TC-06-sync-prices-dry-run", "case": "sync_prices_dry_run", "description": "sync_prices по умолчанию — dry run, база не меняется", "tool": "sync_prices", "args": {}, "expect": {"status": "ok", "json_path_equals": {"dry_run": true}}}
{"id": "TC-07-cost-series-bad-bucket", "case": "cost_series_bad_bucket", "description": "Неизвестный бакет → понятная ошибка", "tool": "cost_series", "args": {"bucket": "fortnight"}, "expect": {"status": "error", "error_contains": "bucket"}}
{"id": "TC-08-economics-report-bad-group", "case": "economics_report_bad_group", "description": "Неизвестная группировка → понятная ошибка", "tool": "economics_report", "args": {"group_by": "phase"}, "expect": {"status": "error", "error_contains": "group_by"}}
{"id": "TC-09-list-prices", "case": "list_prices", "description": "Список цен доступен и помечает источник", "tool": "list_prices", "args": {"model": "claude-*"}, "expect": {"status": "ok"}}
{"id": "TC-10-close-model-price-missing", "case": "close_model_price_missing", "description": "Закрытие несуществующей цены → понятная ошибка", "tool": "close_model_price", "args": {"pattern": "absent-*", "valid_from": "2026-01-01T00:00:00"}, "expect": {"status": "error", "error_contains": "not found"}}
