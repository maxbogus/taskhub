# TaskHub configuration template. Copy to .env only to override defaults.
# Every setting has a working default; see README "Defaults".
#
# Database (default: sqlite+aiosqlite:///$HOME/.taskhub/taskhub.db)
# TASKHUB_DB_URL=sqlite+aiosqlite:////absolute/path/to/.taskhub/taskhub.db
#
# Backups (default: $HOME/.taskhub/backups)
# TASKHUB_BACKUP_DIR=/absolute/path/to/.taskhub/backups
# TASKHUB_BACKUP_KEEP=7

TASKHUB_TRANSPORT=stdio
TASKHUB_HOST=127.0.0.1
TASKHUB_PORT=7801
TASKHUB_WEB_PORT=8000
TASKHUB_METRICS_SOURCES=cline
