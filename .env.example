# TaskHub configuration template. Copy to .env only to override defaults.
# Every setting has a working default; see README "Defaults".
#
# Data directory (default: $HOME/.taskhub). The database and backups are derived
# from it, so a single variable moves all local state.
# TASKHUB_HOME=/absolute/path/to/.taskhub
#
# Database (default: sqlite+aiosqlite:///$TASKHUB_HOME/taskhub.db)
# TASKHUB_DB_URL=sqlite+aiosqlite:////absolute/path/to/.taskhub/taskhub.db
#
# Backups (default: $TASKHUB_HOME/backups)
# TASKHUB_BACKUP_DIR=/absolute/path/to/.taskhub/backups
# TASKHUB_BACKUP_KEEP=7

TASKHUB_TRANSPORT=stdio
# Токен для доступа к REST API и дашборду. Не задан — API открыт.
# TASKHUB_TOKEN=
TASKHUB_HOST=127.0.0.1
TASKHUB_PORT=7801
TASKHUB_WEB_PORT=8000
TASKHUB_METRICS_SOURCES=cline

# Agent economics (M11)
# Ставка человеко-часа — плейсхолдер: задайте свою (USD/час).
# TASKHUB_HUMAN_RATE_USD_PER_HOUR=50
# Цена одной ошибки (потеря от неуспешного прогона).
# TASKHUB_ERROR_COST_USD=0
# Стоимость человеческого надзора за агентами (плоская на проект).
# TASKHUB_SUPERVISION_COST_USD=0
# Файл прайс-листа моделей (по умолчанию src/taskhub/prices.yaml).
# TASKHUB_PRICES_FILE=
# Курс для отображения в рублях. USD остаётся канонической валютой;
# без курса рублёвых полей в отчётах нет.
# TASKHUB_RUB_PER_USD=95
